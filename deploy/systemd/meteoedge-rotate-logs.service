[Unit]
Description=MeteoEdge daily log rotation (all systemd logs)
After=network-online.target
Wants=network-online.target
Documentation=file:///home/p0k5/MeteoEdge/docs/DEPLOY_SYSTEMD_LOG_ROTATION.md

[Service]
Type=oneshot
User=p0k5
WorkingDirectory=/home/p0k5/MeteoEdge
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/p0k5/MeteoEdge/.env
ExecStart=/home/p0k5/MeteoEdge/.venv/bin/python -u /home/p0k5/MeteoEdge/scripts/rotate_bot_log.py
StandardOutput=journal
StandardError=journal
