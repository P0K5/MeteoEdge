[Unit]
Description=MeteoEdge Polymarket SHADOW loop (paper trading, no execution)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p0k5
WorkingDirectory=/home/p0k5/MeteoEdge-Shadow/archive/polymarket-shadow
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/p0k5/MeteoEdge-Shadow/.venv/bin/python -u shadow.py
Restart=always
RestartSec=10s
StandardOutput=append:/home/p0k5/MeteoEdge-Shadow/archive/polymarket-shadow/logs_shadow/shadow.log
StandardError=append:/home/p0k5/MeteoEdge-Shadow/archive/polymarket-shadow/logs_shadow/shadow.log

# Defensive: shadow has no trading keys by design. If a future change ever
# adds EnvironmentFile=.env, make sure that file does NOT include Polymarket
# trading credentials. The shadow process should not be able to place orders.

[Install]
WantedBy=multi-user.target
