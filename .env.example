# MeteoEdge environment configuration
# Copy to .env and fill in your values. Never commit .env.

# ---------------------------------------------------------------------------
# Polymarket CLOB (required for --live mode)
# ---------------------------------------------------------------------------

# L1: your wallet private key — hex string, no 0x prefix
POLYMARKET_API_KEY=your_private_key_here

# L2: derived once from the L1 key via client.create_or_derive_api_creds()
# Run: python3 -c "from py_clob_client_v2 import ClobClient; import os; c = ClobClient('https://clob.polymarket.com', key=os.environ['POLYMARKET_API_KEY'], chain_id=137); cr = c.create_or_derive_api_creds(); print(cr.api_key, cr.api_secret, cr.api_passphrase)"
POLYMARKET_L2_API_KEY=your_l2_api_key_here
POLYMARKET_L2_API_SECRET=your_l2_api_secret_here
POLYMARKET_L2_API_PASSPHRASE=your_l2_api_passphrase_here

# Deposit wallet: ERC-1967 proxy used as order maker in CLOB V2.
# Derived from your EOA via CREATE2 — find it at: polymarket.com → Deposit (the wallet address shown)
POLYMARKET_DEPOSIT_WALLET=your_deposit_wallet_address_here

# 137 = Polygon mainnet (real money), 80002 = Amoy testnet (safe to test)
POLYMARKET_CHAIN_ID=137

# Leave at default unless you need to point at a staging environment
# POLYMARKET_HOST=https://clob.polymarket.com

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------

# Minimum edge in cents to flag a candidate (default: 15)
# MIN_EDGE_CENTS=15.0

# ---------------------------------------------------------------------------
# Position sizing & risk limits
# ---------------------------------------------------------------------------

# EUR staked per trade (default: 5.0)
POSITION_SIZE_EUR=5.0

# Starting capital — used as reference for drawdown calculation (default: 500.0)
# Week 1 live: set to 100.0
STARTING_CAPITAL_EUR=100.0

# Stop trading for the day if daily loss exceeds this (default: 50.0)
# Week 1 live: set to 10.0 (10% of week 1 capital)
RISK_DAILY_LOSS_LIMIT_EUR=10.0

# Max simultaneous open positions (default: 15)
# RISK_MAX_OPEN_POSITIONS=15

# Stop all trading if drawdown exceeds this fraction of starting capital (default: 0.15 = 15%)
# RISK_DRAWDOWN_STOP_PCT=0.15

# Minimum combined order book size to accept a trade (default: 50 contracts)
# RISK_MIN_LIQUIDITY=50

# ---------------------------------------------------------------------------
# Email alerts (Epic 4)
# ---------------------------------------------------------------------------

# Gmail address to send alerts from (must match the App Password below)
SMTP_USER=your_gmail_address@gmail.com

# Gmail App Password — NOT your regular password.
# Generate at: Google Account → Security → 2-Step Verification → App passwords
SMTP_PASS=your_gmail_app_password_here

# Recipient for health report and alert emails
ALERT_EMAIL_TO=your_email@gmail.com

# ---------------------------------------------------------------------------
# Database paths
# ---------------------------------------------------------------------------

# Path to the live trading database (default: data/meteoedge.db)
# DB_PATH=data/meteoedge.db

# Path to the analytics (archival) database (default: data/analytics.db)
# ARCHIVE_DB_PATH=data/analytics.db
# Note: See OPERATIONS.md "Database Layout" section for table descriptions and archival lag.

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------

# Poll interval in seconds (default: 300 = 5 minutes)
# POLL_INTERVAL_SECONDS=300

# Enable live CLOB orderbook enrichment per bracket — more accurate prices,
# but adds ~2 API calls per candidate per poll (default: false)
# ENABLE_CLOB_ENRICHMENT=false

# ---------------------------------------------------------------------------
# Data Retention
# ---------------------------------------------------------------------------

# Days to retain snapshot JSONL files (default: 365; overrides LOG_ROTATION_RETAIN_DAYS for snapshots only)
# SNAPSHOT_RETAIN_DAYS=365

# ---------------------------------------------------------------------------
# Remote Server (for data sync via fetch_remote_data.sh)
# ---------------------------------------------------------------------------

# Server hostname or IP address
# REMOTE_HOST=p0k5-macmini

# SSH username
# REMOTE_USER=p0k5

# Path to SSH private key (use ~ for home directory)
# REMOTE_KEY_PATH=~/.ssh/meteoedge_key

# Project root on remote server (MeteoEdge base path)
# REMOTE_PROJECT_ROOT=/home/p0k5/MeteoEdge
